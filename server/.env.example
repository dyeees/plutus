# Copy to .env and fill in Aiven credentials.

CORS_ORIGIN=http://localhost:5173

# Aiven console -> your MySQL service -> Overview -> Service URI
DATABASE_URL=
# Or set individual values instead of DATABASE_URL:
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Aiven requires TLS. Set DB_SSL=false only for a local non-TLS MySQL.
DB_SSL=true
# Optional: path to Aiven CA certificate (ca.pem) for strict verification.
DB_SSL_CA=./certs/ca.pem